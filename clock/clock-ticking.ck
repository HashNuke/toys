// Procedural clock modeled on Session's Clock Ticking.wav.
// No recorded audio is loaded or played. Standard ChucK UGens only.
// chuck clock/clock-ticking.ck[:beatMs:volume:seconds:output.wav]
1000.0 => float beatMs;
0.65 => float volume;
0.0 => float seconds;
if(me.args() > 0) Std.atof(me.arg(0)) => beatMs;
if(me.args() > 1) Std.atof(me.arg(1)) => volume;
if(me.args() > 2) Std.atof(me.arg(2)) => seconds;
if(beatMs < 300.0 || volume < 0.0 || volume > 1.0 || seconds < 0.0)
{
    <<< "Use beat >= 300 ms, volume 0..1, duration >= 0 seconds." >>>;
    me.exit();
}

