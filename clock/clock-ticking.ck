] @=> float contours[][];

Noise excitation[32];
BiQuad resonance[32];
Gain envelope[32];
Gain mix => HPF dcBlock => Gain output => dac;
45.0 => dcBlock.freq;
volume => output.gain;
for(0 => int band; band < 32; band++)
{
    excitation[band] => resonance[band] => envelope[band] => mix;
    // Normalize each resonator to unit RMS with white noise input.
    b0[band] => resonance[band].b0;
    0.0 => resonance[band].b1;
    b2[band] => resonance[band].b2;
    a1[band] => resonance[band].a1;
    a2[band] => resonance[band].a2;
    Math.sqrt(3.0) => excitation[band].gain;
    0.0 => envelope[band].gain;
}
WvOut recording;
if(me.args() > 3)
{
    output => recording => blackhole;
    me.arg(3) => recording.wavFilename;
}

fun void strike()
{
    Math.random2f(0.96, 1.04) => float strength;
    // Interpolate the 2 ms envelopes at audio rate to avoid zipper noise.
    for(0 => int frame; frame < contours[0].size(); frame++)
    {
        now => time frameStart;
        while(now - frameStart < 2::ms)
        {
            (now - frameStart) / (2::ms) => float fraction;
            for(0 => int band; band < 32; band++)
            {
                0.0 => float target;
                if(frame + 1 < contours[band].size())
                    contours[band][frame + 1] => target;
                strength * (contours[band][frame] * (1.0 - fraction)
                    + target * fraction) => envelope[band].gain;
            }
            1::samp => now;
        }
    }
    for(0 => int band; band < 32; band++) 0.0 => envelope[band].gain;
}

now => time started;
now => time nextBeat;
while(seconds == 0.0 || nextBeat < started + seconds::second)
{
    spork ~ strike();
    beatMs::ms +=> nextBeat;
    if(seconds > 0.0 && nextBeat > started + seconds::second)
        started + seconds::second => nextBeat;
    nextBeat => now;
}
300::ms => now;
if(me.args() > 3) recording.closeFile();
